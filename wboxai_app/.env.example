# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Models (optional)
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_CHAT_MODEL=gpt-4o-mini

# Audio: loopback = system audio (Windows Stereo Mix / Mac BlackHole)
#         microphone = default mic (recommended on Mac without BlackHole)
AUDIO_SOURCE=loopback

# Enterprise microphone-to-text pipeline
ENTERPRISE_AUDIO=true
AUDIO_STT_PROVIDER=sensevoice
AUDIO_STT_MODEL=iic/SenseVoiceSmall
AUDIO_LANGUAGE=auto
# Falls back to energy VAD/OpenAI STT until optional local packages are installed
AUDIO_ALLOW_FALLBACK=true
# Keep audio transcription local-only (recommended)
AUDIO_ALLOW_OPENAI_STT=false

# Path to resume text for personalized answers (optional)
RESUME_CONTEXT_PATH=resume_context.txt

# Interview context you can customize
JOB_ROLE=Software Engineer
JOB_DESCRIPTION=

# Coding interviews (CoderPad, HackerRank, LeetCode)
CODE_LANGUAGE=python
# auto = detect coding questions | always = always use coding format
CODING_MODE=auto

# Screen scan — read problem from CoderPad without copy-paste
OPENAI_VISION_MODEL=gpt-4o
SCREEN_CAPTURE_MAX_WIDTH=1920
SCREEN_WATCH_INTERVAL_SEC=18
# Start with Watch on at launch (auto-detect when screen changes)
SCREEN_WATCH_ENABLED=false

# Performance (small laptops) — true = 1 worker, 1280px screenshots, slower watch
LIGHTWEIGHT_MODE=true
MAX_WORKERS=1
SCREEN_CAPTURE_MAX_WIDTH=1280
SCREEN_CAPTURE_QUALITY=72
SCREEN_WATCH_INTERVAL_SEC=30
EXCLUDE_REFRESH_SEC=12

# Hide from Zoom/Teams screen share (keep true on Windows)
INVISIBLE_IN_SHARE=true

# Semi-transparent overlay (see through to your screen behind the panel)
OVERLAY_TRANSPARENT=true

# Keep HackerRank/CoderPad focused: hover+scroll overlay, no focus steal (Windows)
STEALTH_FOCUS=true

# OS blur 0–100 (0.4 = minimal edge softening, no white wash under 2%)

# Path to resume text for personalized answers (optional)
RESUME_CONTEXT_PATH=resume_context.txt

# Interview context you can customize
JOB_ROLE=Software Engineer
JOB_DESCRIPTION=

# Coding interviews (CoderPad, HackerRank, LeetCode)
CODE_LANGUAGE=python
# auto = detect coding questions | always = always use coding format
CODING_MODE=auto

# Screen scan — read problem from CoderPad without copy-paste
OPENAI_VISION_MODEL=gpt-4o
SCREEN_CAPTURE_MAX_WIDTH=1920
SCREEN_WATCH_INTERVAL_SEC=18
# Start with Watch on at launch (auto-detect when screen changes)
SCREEN_WATCH_ENABLED=false

# Performance (small laptops) — true = 1 worker, 1280px screenshots, slower watch
LIGHTWEIGHT_MODE=true
MAX_WORKERS=1
SCREEN_CAPTURE_MAX_WIDTH=1280
SCREEN_CAPTURE_QUALITY=72
SCREEN_WATCH_INTERVAL_SEC=30
EXCLUDE_REFRESH_SEC=12

# Hide from Zoom/Teams screen share (keep true on Windows)
INVISIBLE_IN_SHARE=true

# Semi-transparent overlay (see through to your screen behind the panel)
OVERLAY_TRANSPARENT=true

# Keep HackerRank/CoderPad focused: hover+scroll overlay, no focus steal (Windows)
STEALTH_FOCUS=true

# OS blur 0–100 (0.4 = minimal edge softening, no white wash under 2%)
GLASS_BLUR_PERCENT=0.4
# Panel white tint 0–30 (0 = fully transparent)
GLASS_PANEL_TINT_PERCENT=0
# See background through overlay (true recommended for coding tabs)
GLASS_SEE_THROUGH=true

# SSL for OpenAI (Windows: truststore uses OS certs — installed via requirements.txt)
SSL_VERIFY=true
# Last resort only if SSL still fails:
# SSL_VERIFY=false

# Email Transcript Settings (Optional)
# Enter the recipient email to automatically receive interview transcripts and latency logs upon exit.
EMAIL_RECEIVER=
# If using Gmail, you must generate and use an App Password instead of your regular password.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Gemini Settings (Optional)
# Get your API key from Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude Settings (Optional)
# Get your API key from Anthropic Console
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

